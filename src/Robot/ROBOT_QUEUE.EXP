(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := 'Robot' *)
(* @OBJECTFLAGS := '0, 8' *)
PROGRAM Robot_Queue
VAR
	slot_index : INT;
	target_available : BOOL;
	tracking_step : UDINT;
END_VAR

ROBOT_TARGET_REQUEST := FALSE;
target_available := FALSE;
tracking_step := 0;

IF ROBOT_RESET_REQUEST THEN
	FOR slot_index := 0 TO ROBOT_MAX_TARGETS DO
		ROBOT_TARGETS[slot_index].Id := 0;
		ROBOT_TARGETS[slot_index].MaterialIndex := 0;
		ROBOT_TARGETS[slot_index].MaterialCode := 0;
		ROBOT_TARGETS[slot_index].BoxIndex := 0;
		ROBOT_TARGETS[slot_index].FirstTrack := 0;
		ROBOT_TARGETS[slot_index].LastTrack := 0;
		ROBOT_TARGETS[slot_index].CenterTrack := 0.0;
		ROBOT_TARGETS[slot_index].PickX := 0.0;
		ROBOT_TARGETS[slot_index].PickY := 0.0;
		ROBOT_TARGETS[slot_index].PickZ := 0.0;
		ROBOT_TARGETS[slot_index].PickAngle := 0.0;
		ROBOT_TARGETS[slot_index].PositionImpulses := 0;
		ROBOT_TARGETS[slot_index].Valid := FALSE;
		ROBOT_TARGETS[slot_index].InWindow := FALSE;
		ROBOT_TARGETS[slot_index].Sent := FALSE;
		ROBOT_TARGETS[slot_index].Picked := FALSE;
		ROBOT_TARGETS[slot_index].Failed := FALSE;
		ROBOT_TARGETS[slot_index].Missed := FALSE;
	END_FOR
	ROBOT_CURRENT_TARGET.Id := 0;
	ROBOT_CURRENT_TARGET.MaterialIndex := 0;
	ROBOT_CURRENT_TARGET.MaterialCode := 0;
	ROBOT_CURRENT_TARGET.BoxIndex := 0;
	ROBOT_CURRENT_TARGET.FirstTrack := 0;
	ROBOT_CURRENT_TARGET.LastTrack := 0;
	ROBOT_CURRENT_TARGET.CenterTrack := 0.0;
	ROBOT_CURRENT_TARGET.PickX := 0.0;
	ROBOT_CURRENT_TARGET.PickY := 0.0;
	ROBOT_CURRENT_TARGET.PickZ := 0.0;
	ROBOT_CURRENT_TARGET.PickAngle := 0.0;
	ROBOT_CURRENT_TARGET.PositionImpulses := 0;
	ROBOT_CURRENT_TARGET.Valid := FALSE;
	ROBOT_CURRENT_TARGET.InWindow := FALSE;
	ROBOT_CURRENT_TARGET.Sent := FALSE;
	ROBOT_CURRENT_TARGET.Picked := FALSE;
	ROBOT_CURRENT_TARGET.Failed := FALSE;
	ROBOT_CURRENT_TARGET.Missed := FALSE;
	ROBOT_NEXT_ID := 1;
	ROBOT_LAST_PROCESSED_NIR_INDEX := 999;
	ROBOT_ENCODER_STEP_VALID := FALSE;
	ROBOT_ENCODER_STEP_IMP := 0;
	ROBOT_ENCODER_PENDING_IMP := 0;
	ROBOT_TARGETS_DETECTED := 0;
	ROBOT_TARGETS_SENT := 0;
	ROBOT_TARGETS_PICKED := 0;
	ROBOT_TARGETS_FAILED := 0;
	ROBOT_TARGETS_MISSED := 0;
	ROBOT_QUEUE_FULL_COUNT := 0;
	ROBOT_COMMAND_STRING := '';
	ROBOT_COMMAND_READY := FALSE;
	ROBOT_COMMAND_SENT := FALSE;
	ROBOT_TEST_CREATE_TARGET := FALSE;
	ROBOT_RESET_REQUEST := FALSE;
END_IF

IF ROBOT_SIMULATION THEN
	tracking_step := ROBOT_SIM_TRACKING_STEP_IMP;
ELSIF ROBOT_ENCODER_STEP_VALID THEN
	tracking_step := ROBOT_ENCODER_PENDING_IMP;
	ROBOT_ENCODER_STEP_IMP := 0;
	ROBOT_ENCODER_PENDING_IMP := 0;
	ROBOT_ENCODER_STEP_VALID := FALSE;
END_IF

IF ROBOT_ENABLED THEN
	FOR slot_index := 0 TO ROBOT_MAX_TARGETS DO
		IF ROBOT_TARGETS[slot_index].Valid AND NOT ROBOT_TARGETS[slot_index].Picked AND NOT ROBOT_TARGETS[slot_index].Failed AND NOT ROBOT_TARGETS[slot_index].Missed THEN
			IF tracking_step > 0 THEN
				ROBOT_TARGETS[slot_index].PositionImpulses := ROBOT_TARGETS[slot_index].PositionImpulses + tracking_step;
			END_IF

			IF ROBOT_TARGETS[slot_index].PositionImpulses >= ROBOT_PICK_WINDOW_START_IMP AND ROBOT_TARGETS[slot_index].PositionImpulses <= ROBOT_PICK_WINDOW_END_IMP THEN
				ROBOT_TARGETS[slot_index].InWindow := TRUE;
			ELSE
				ROBOT_TARGETS[slot_index].InWindow := FALSE;
			END_IF

			IF ROBOT_TARGETS[slot_index].PositionImpulses > ROBOT_PICK_WINDOW_END_IMP AND NOT ROBOT_TARGETS[slot_index].Sent THEN
				ROBOT_TARGETS[slot_index].Missed := TRUE;
				ROBOT_TARGETS_MISSED := ROBOT_TARGETS_MISSED + 1;
			END_IF

			IF ROBOT_TARGETS[slot_index].InWindow AND NOT ROBOT_TARGETS[slot_index].Sent AND ROBOT_STATE_GLOBAL.Ready AND NOT target_available THEN
				ROBOT_CURRENT_TARGET.Id := ROBOT_TARGETS[slot_index].Id;
				ROBOT_CURRENT_TARGET.MaterialIndex := ROBOT_TARGETS[slot_index].MaterialIndex;
				ROBOT_CURRENT_TARGET.MaterialCode := ROBOT_TARGETS[slot_index].MaterialCode;
				ROBOT_CURRENT_TARGET.BoxIndex := ROBOT_TARGETS[slot_index].BoxIndex;
				ROBOT_CURRENT_TARGET.FirstTrack := ROBOT_TARGETS[slot_index].FirstTrack;
				ROBOT_CURRENT_TARGET.LastTrack := ROBOT_TARGETS[slot_index].LastTrack;
				ROBOT_CURRENT_TARGET.CenterTrack := ROBOT_TARGETS[slot_index].CenterTrack;
				ROBOT_CURRENT_TARGET.PickX := ROBOT_TARGETS[slot_index].PickX;
				ROBOT_CURRENT_TARGET.PickY := ROBOT_TARGETS[slot_index].PickY;
				ROBOT_CURRENT_TARGET.PickZ := ROBOT_TARGETS[slot_index].PickZ;
				ROBOT_CURRENT_TARGET.PickAngle := ROBOT_TARGETS[slot_index].PickAngle;
				ROBOT_CURRENT_TARGET.PositionImpulses := ROBOT_TARGETS[slot_index].PositionImpulses;
				ROBOT_CURRENT_TARGET.Valid := ROBOT_TARGETS[slot_index].Valid;
				ROBOT_CURRENT_TARGET.InWindow := ROBOT_TARGETS[slot_index].InWindow;
				ROBOT_CURRENT_TARGET.Sent := TRUE;
				ROBOT_CURRENT_TARGET.Picked := FALSE;
				ROBOT_CURRENT_TARGET.Failed := FALSE;
				ROBOT_CURRENT_TARGET.Missed := FALSE;
				ROBOT_TARGET_REQUEST := TRUE;
				ROBOT_TARGETS[slot_index].Sent := TRUE;
				ROBOT_TARGETS_SENT := ROBOT_TARGETS_SENT + 1;
				target_available := TRUE;
			END_IF

			IF ROBOT_SIM_PICK_DONE AND ROBOT_TARGETS[slot_index].Id = ROBOT_CURRENT_TARGET.Id THEN
				ROBOT_TARGETS[slot_index].Picked := TRUE;
				ROBOT_TARGETS_PICKED := ROBOT_TARGETS_PICKED + 1;
				ROBOT_TARGETS[slot_index].Valid := FALSE;
			END_IF
		END_IF
	END_FOR
END_IF
END_PROGRAM
