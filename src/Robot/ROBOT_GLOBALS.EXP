(* @NESTEDCOMMENTS := 'Yes' *)
(* @GLOBAL_VARIABLE_LIST := 'Robot_Globals' *)
(* @PATH := 'Robot' *)
(* @OBJECTFLAGS := '0, 8' *)
VAR_GLOBAL CONSTANT
	ROBOT_MAX_TARGETS : INT := 49;
	ROBOT_MAX_BOXES : INT := 20;
	ROBOT_NIR_LAST_INDEX : UINT := 150;
END_VAR

VAR_GLOBAL
	ROBOT_STATE_GLOBAL : ROBOT_STATE;
	ROBOT_TARGETS : ARRAY [0..49] OF ROBOT_TARGET;
	ROBOT_CURRENT_TARGET : ROBOT_TARGET;
	ROBOT_NEXT_ID : INT := 1;
	ROBOT_LAST_PROCESSED_NIR_INDEX : UINT := 999;
	ROBOT_TARGET_REQUEST : BOOL;
	ROBOT_TARGET_ACCEPTED : BOOL;
	ROBOT_COMMAND_STRING : STRING(255);
	ROBOT_COMMAND_READY : BOOL;
	ROBOT_COMMAND_SENT : BOOL;
	ROBOT_ENCODER_STEP_VALID : BOOL;
	ROBOT_ENCODER_STEP_IMP : UDINT;
	ROBOT_ENCODER_PENDING_IMP : UDINT;
	ROBOT_TARGETS_DETECTED : UDINT;
	ROBOT_TARGETS_SENT : UDINT;
	ROBOT_TARGETS_PICKED : UDINT;
	ROBOT_TARGETS_FAILED : UDINT;
	ROBOT_TARGETS_MISSED : UDINT;
	ROBOT_QUEUE_FULL_COUNT : UDINT;
	ROBOT_SIM_PICK_TIME : TIME := T#500MS;
	ROBOT_SIM_PICK_DONE : BOOL;
	ROBOT_RESET_REQUEST : BOOL;
	ROBOT_TEST_CREATE_TARGET : BOOL;
END_VAR

VAR_GLOBAL PERSISTENT
	ROBOT_ENABLED : BOOL := FALSE;
	ROBOT_SIMULATION : BOOL := TRUE;
	ROBOT_TRACK_PITCH_MM : REAL := 12.82;
	ROBOT_X_ORIGIN_MM : REAL := 0.0;
	ROBOT_PICK_Y_MM : REAL := 0.0;
	ROBOT_PICK_Z_MM : REAL := 100.0;
	ROBOT_PICK_ANGLE_DEG : REAL := 0.0;
	ROBOT_PICK_WINDOW_START_IMP : UDINT := 180;
	ROBOT_PICK_WINDOW_END_IMP : UDINT := 260;
	ROBOT_MIN_WIDTH_TRACKS : INT := 1;
	ROBOT_MAX_WIDTH_TRACKS : INT := 20;
	ROBOT_SIM_TRACKING_STEP_IMP : UDINT := 5;
	ROBOT_WAIT_PICK_MS : INT := 0;
	ROBOT_WAIT_DROP_MS : INT := 0;
	ROBOT_TEST_INPUT_ENABLED : BOOL := FALSE;
	ROBOT_TEST_MATERIAL_INDEX : INT := 0;
	ROBOT_TEST_MATERIAL_CODE : BYTE := 1;
	ROBOT_TEST_BOX_INDEX : INT := 1;
	ROBOT_TEST_FIRST_TRACK : INT := 50;
	ROBOT_TEST_LAST_TRACK : INT := 55;
	MATERIALI_ATTIVI_BOX : ARRAY [0..100] OF INT;
	X_BOX : ARRAY [0..20] OF REAL;
	Y_BOX : ARRAY [0..20] OF REAL;
	Z_BOX : ARRAY [0..20] OF REAL;
END_VAR
(* @OBJECT_END := 'Robot_Globals' *)
