(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := 'Robot' *)
(* @OBJECTFLAGS := '0, 8' *)
PROGRAM Gestione_Robot
VAR
	pick_timer : TON;
	timer_active : BOOL;
	command_box_index : INT;
END_VAR
(* @END_DECLARATION := '0' *)

ROBOT_SIM_PICK_DONE := FALSE;
ROBOT_COMMAND_SENT := FALSE;

ROBOT_STATE_GLOBAL.Enabled := ROBOT_ENABLED;
ROBOT_STATE_GLOBAL.Simulation := ROBOT_SIMULATION;

IF NOT ROBOT_ENABLED THEN
	ROBOT_STATE_GLOBAL.Ready := FALSE;
	ROBOT_STATE_GLOBAL.Busy := FALSE;
	ROBOT_STATE_GLOBAL.Error := FALSE;
	ROBOT_STATE_GLOBAL.Ack := FALSE;
	ROBOT_STATE_GLOBAL.PickDone := FALSE;
	ROBOT_STATE_GLOBAL.PickFailed := FALSE;
	ROBOT_COMMAND_ID := 0;
	ROBOT_COMMAND_PICK_X := 0.0;
	ROBOT_COMMAND_PICK_Y := 0.0;
	ROBOT_COMMAND_PICK_Z := 0.0;
	ROBOT_COMMAND_PICK_ANGLE := 0.0;
	ROBOT_COMMAND_WAIT_PICK_MS := 0;
	ROBOT_COMMAND_DROP_X := 0.0;
	ROBOT_COMMAND_DROP_Y := 0.0;
	ROBOT_COMMAND_DROP_Z := 0.0;
	ROBOT_COMMAND_WAIT_DROP_MS := 0;
	ROBOT_COMMAND_STRING := '';
	ROBOT_COMMAND_READY := FALSE;
	timer_active := FALSE;
ELSE
	IF ROBOT_SIMULATION THEN
		IF NOT ROBOT_STATE_GLOBAL.Busy THEN
			ROBOT_STATE_GLOBAL.Ready := TRUE;
		END_IF

		IF ROBOT_TARGET_REQUEST AND ROBOT_STATE_GLOBAL.Ready THEN
			ROBOT_STATE_GLOBAL.Ready := FALSE;
			ROBOT_STATE_GLOBAL.Busy := TRUE;
			ROBOT_STATE_GLOBAL.Ack := TRUE;
			ROBOT_STATE_GLOBAL.PickDone := FALSE;
			ROBOT_STATE_GLOBAL.PickFailed := FALSE;
			ROBOT_STATE_GLOBAL.CurrentTargetId := ROBOT_CURRENT_TARGET.Id;
			IF ROBOT_CURRENT_TARGET.BoxIndex >= 0 AND ROBOT_CURRENT_TARGET.BoxIndex <= ROBOT_MAX_BOXES THEN
				command_box_index := ROBOT_CURRENT_TARGET.BoxIndex;
			ELSE
				command_box_index := 0;
			END_IF
			ROBOT_COMMAND_ID := ROBOT_CURRENT_TARGET.Id;
			ROBOT_COMMAND_PICK_X := ROBOT_CURRENT_TARGET.PickX;
			ROBOT_COMMAND_PICK_Y := ROBOT_CURRENT_TARGET.PickY;
			ROBOT_COMMAND_PICK_Z := ROBOT_CURRENT_TARGET.PickZ;
			ROBOT_COMMAND_PICK_ANGLE := ROBOT_CURRENT_TARGET.PickAngle;
			ROBOT_COMMAND_WAIT_PICK_MS := ROBOT_WAIT_PICK_MS;
			ROBOT_COMMAND_DROP_X := X_BOX[command_box_index];
			ROBOT_COMMAND_DROP_Y := Y_BOX[command_box_index];
			ROBOT_COMMAND_DROP_Z := Z_BOX[command_box_index];
			ROBOT_COMMAND_WAIT_DROP_MS := ROBOT_WAIT_DROP_MS;
			ROBOT_COMMAND_STRING := '';
			ROBOT_COMMAND_READY := TRUE;
			ROBOT_COMMAND_SENT := TRUE;
			timer_active := TRUE;
		ELSE
			ROBOT_STATE_GLOBAL.Ack := FALSE;
			ROBOT_COMMAND_READY := FALSE;
		END_IF

		pick_timer(IN := timer_active, PT := ROBOT_SIM_PICK_TIME, Q => , ET => );
		IF pick_timer.Q THEN
			timer_active := FALSE;
			ROBOT_STATE_GLOBAL.Busy := FALSE;
			ROBOT_STATE_GLOBAL.Ready := TRUE;
			ROBOT_STATE_GLOBAL.PickDone := TRUE;
			ROBOT_SIM_PICK_DONE := TRUE;
		END_IF
	ELSE
		(* In Fase 2 qui verra' implementato il protocollo robot reale. *)
		ROBOT_STATE_GLOBAL.Ready := FALSE;
		ROBOT_STATE_GLOBAL.Busy := FALSE;
		ROBOT_COMMAND_READY := FALSE;
	END_IF
END_IF
END_PROGRAM
